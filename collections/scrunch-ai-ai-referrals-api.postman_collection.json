        {
          "id": "8f1017fd-264a-4c99-87d4-0dec48a1400d",
          "name": "Push AI Referrals Events",
          "request": {
            "name": "Push AI Referrals Events",
            "description": {
              "content": "Push a batch of pre-aggregated daily AI-referral events for a registered connection.\n\nAccepts `application/json` (a JSON array of events) or `application/x-ndjson` (one event per line). The upsert key is `(date, raw_referrer_value, raw_page_value)` — re-sending the same tuple replaces the prior values, so backfills and corrections are safe to retry.\n\nLimits:\n- Maximum 10,000 events per batch.\n- Maximum 5 MB request body.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                ":brand_id",
                "ai-referrals",
                "connections",
                ":connection_id",
                "events"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<integer>",
                  "key": "brand_id",
                  "description": "(Required) The unique identifier for the brand."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "connection_id",
                  "description": "(Required) The ULID of the AI Referrals connection."
                }
              ]
            },
            "header": [
