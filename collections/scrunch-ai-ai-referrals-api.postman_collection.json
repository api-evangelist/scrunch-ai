            },
            "body": {
              "mode": "raw",
              "raw": "[\n  {\n    \"date\": \"<date>\",\n    \"raw_referrer_value\": \"<string>\",\n    \"raw_page_value\": \"<string>\",\n    \"pageviews\": \"<integer,null>\",\n    \"sessions\": \"<integer,null>\",\n    \"transactions\": \"<integer,null>\",\n    \"purchase_revenue\": \"<number,null>\",\n    \"batch_id\": \"<string,null>\"\n  },\n  {\n    \"date\": \"<date>\",\n    \"raw_referrer_value\": \"<string>\",\n    \"raw_page_value\": \"<string>\",\n    \"pageviews\": \"<integer,null>\",\n    \"sessions\": \"<integer,null>\",\n    \"transactions\": \"<integer,null>\",\n    \"purchase_revenue\": \"<number,null>\",\n    \"batch_id\": \"<string,null>\"\n  }\n]",
