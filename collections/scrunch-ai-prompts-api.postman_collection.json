          "name": "List Prompts",
          "request": {
            "name": "List Prompts",
            "description": {
              "content": "Returns a paginated list of active prompts for the specified brand, including their variants, tags, and topics. Use this endpoint to retrieve all prompts configured for AI visibility tracking.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                ":brand_id",
                "prompts"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "100",
                  "description": "Maximum number of prompts to return per page."
                },
                {
                  "disabled": false,
                  "key": "offset",
                  "value": "0",
                  "description": "Number of prompts to skip for pagination."
                },
                {
                  "disabled": false,
                  "key": "stage",
                  "value": "<string>",
                  "description": "Filter prompts by journey stage. Values are resolved from your brand's configured stages, so they vary per brand.\n\n**Default stage sets:**\n- **Intent (v1)** — `Advice`, `Awareness`, `Evaluation`, `Comparison`, `Other`\n- **Funnel (v2)** — `Awareness`, `Consideration`, `Conversion`, `Loyalty`, `Other`\n\nBrands that rename or add stages accept those custom names too. A value that doesn't match any of the brand's active stages matches zero rows rather than erroring."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<integer>",
