        {
          "id": "d7a50305-f392-46e2-8d97-f599f9422d7f",
          "name": "Create Prompt",
          "request": {
            "name": "Create Prompt",
            "description": {
              "content": "Creates a new prompt with variants for the specified platforms. Requires the `configure` scope.\n\n**Behavior:**\n- `stage` is optional. If omitted, the journey stage is auto-classified against your brand's active stages using an LLM.\n- If `stage` is provided, it must match one of your brand's active stages (case-sensitive display name). An unknown value returns `400`. An explicit stage is treated as a manual assertion and won't be overwritten by later re-classification.\n- Creates variants for each specified platform.\n- Reactivates an archived prompt if a duplicate exists.\n- Dispatches collection events to begin tracking.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                ":brand_id",
                "prompts"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<integer>",
                  "key": "brand_id",
                  "description": "(Required) The unique identifier for the brand"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
