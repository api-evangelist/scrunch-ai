        {
          "id": "e30baa38-540f-411d-8266-8bec4bb3b2b9",
          "name": "Bulk Render Optimized Pages",
          "request": {
            "name": "Bulk Render Optimized Pages",
            "description": {
              "content": "Queue render jobs for a list of paths on a registered AXP site. Each path is fetched, sanitized, and persisted as an AXP optimized page asynchronously, so the endpoint returns immediately with one job entry per input path.\n\nPaths are normalized (trimmed and given a leading slash) and deduplicated before queueing. A path that already has an in-flight job on the same site coalesces onto that job, so the same batch can be retried safely. Inputs are capped at 100 paths per call.",
              "type": "text/plain"
            },
            "url": {
              "protocol": "https",
              "path": [
                "v2",
                "orchestration",
                "render-bulk",
                ":brand_id",
                "sites",
                ":site_id"
              ],
              "host": [
                "api",
                "scrunchai",
                "com"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<integer>",
                  "key": "brand_id",
                  "description": "(Required) The unique identifier for the brand that owns the site."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "site_id",
                  "description": "(Required) The ULID of the registered AXP site to render pages on."
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paths\": [\n    \"<string>\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
